{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "127.0.0.1:8000"
      ],
      "env": {
        "DJANGO_DEBUG": "1",
        "PEER_AUTH_SECRET": "local-dev-peer-secret",
        "PEER_URL": "http://127.0.0.1:8001/marine/api/v1"
      },
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "backend-marine",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "127.0.0.1:8001"
      ],
      "env": {
        "DJANGO_DEBUG": "1",
        "APP_PREFIX": "/marine",
        "SQLITE_NAME": "db.marine.sqlite3",
        "MEDIA_DIR": "media-marine",
        "PEER_AUTH_SECRET": "local-dev-peer-secret",
        "PEER_URL": "http://127.0.0.1:8000/api/v1"
      },
      "port": 8001
    }
  ]
}
