# Sandplanet Marine instance — copy to .env.marine and fill in. Same keys as
# .env (see .env.prod.example) with the Marine company's own values.
POSTGRES_DB=marine
POSTGRES_USER=marine
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-too
DJANGO_ALLOWED_HOSTS=app.sandplanet.mv,web-marine
DJANGO_DEBUG=0
# Uploads: a Spaces bucket (or prefix) of Marine's own, so the two companies'
# files never mix.
S3_ENDPOINT_URL=https://sgp1.digitaloceanspaces.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=sandplanet-marine
PDF_REQUIRED=1
SECURE_SSL_REDIRECT=1
# First start only: RUN_SEED_MARINE=1 docker compose … up -d web-marine
SEED_ADMIN_PASSWORD=change-me-as-well

# --- the bridge to Sand Planet (core/peer_auth.py) ---------------------------
# The SAME secret as PEER_AUTH_SECRET in .env; Planet's internal address.
PEER_AUTH_SECRET=CHANGE_ME_same_value_in_both_env_files
PEER_URL=http://web:8000/api/v1
GUNICORN_WORKERS=3
